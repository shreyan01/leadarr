# --- App ---
ENVIRONMENT=development
DEBUG=true
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://leadforge:leadforge@postgres:5432/leadforge
DATABASE_URL_SYNC=postgresql+psycopg2://leadforge:leadforge@postgres:5432/leadforge

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Auth --- (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- AI Providers ---
# Chat, vision, AND embeddings all default to local, free, self-hosted
# models — nothing billed per token, no API key needed anywhere below.
#   - Chat + vision both use Qwen2.5-VL (docker-compose.yml's qwen-vl
#     service) — it's a capable general chat model, not just vision, so
#     reusing it for report/email generation costs zero extra GPU memory.
#   - Embeddings use Qwen3-Embedding-0.6B (docker-compose.yml's qwen-embed
#     service) — a small, dedicated embedding model, not the same
#     architecture as Qwen2.5-VL, so it runs as its own lightweight service.
#
# Free alternatives if you'd rather not load your GPU with chat traffic:
#   AI_CHAT_PROVIDER=gemini   + GEMINI_API_KEY  (Google AI Studio free tier:
#     no card required, rate-limited rather than billed — note free-tier
#     prompts may be used by Google to improve their models)
#   AI_CHAT_PROVIDER=ollama   + a small local model (llama3.1:8b etc.) if
#     you'd rather not share Qwen's GPU slot with vision calls
#
# Anthropic/OpenAI (AI_CHAT_PROVIDER=anthropic / openai) are paid,
# per-token APIs — only set these if you want their quality/features and
# are fine paying for it.
AI_CHAT_PROVIDER=qwen
AI_VISION_PROVIDER=qwen_vl
AI_EMBEDDING_PROVIDER=qwen

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
QWEN_VL_BASE_URL=http://qwen-vl:8001
QWEN_EMBED_BASE_URL=http://qwen-embed:8002

DEFAULT_CHAT_MODEL=qwen2.5-vl-7b
DEFAULT_VISION_MODEL=qwen2.5-vl-7b
DEFAULT_EMBEDDING_MODEL=qwen3-embedding-0.6b

# --- Email ---
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
RESEND_API_KEY=
SENDGRID_API_KEY=
AWS_SES_REGION=
EMAIL_FROM_ADDRESS=noreply@leadforge.local

# --- Discovery ---
DISCOVERY_PROVIDER=google_places
GOOGLE_PLACES_API_KEY=

# --- Storage ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

# --- Lighthouse / Playwright ---
LIGHTHOUSE_CLI_PATH=lighthouse
PLAYWRIGHT_HEADLESS=true

RATE_LIMIT_PER_MINUTE=60