# --- App ---
ENVIRONMENT=development
DEBUG=true
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://leadforge:leadforge@postgres:5432/leadforge
DATABASE_URL_SYNC=postgresql+psycopg2://leadforge:leadforge@postgres:5432/leadforge

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Auth --- (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- AI Providers ---
# Vision runs entirely locally against the qwen-vl container below — no
# vision API key is used or required.
AI_CHAT_PROVIDER=anthropic
AI_VISION_PROVIDER=qwen_vl
AI_EMBEDDING_PROVIDER=openai

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
QWEN_VL_BASE_URL=http://qwen-vl:8001

DEFAULT_CHAT_MODEL=claude-sonnet-4-6
DEFAULT_VISION_MODEL=qwen2.5-vl-7b

# --- Email ---
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
RESEND_API_KEY=
SENDGRID_API_KEY=
AWS_SES_REGION=
EMAIL_FROM_ADDRESS=noreply@leadforge.local

# --- Discovery ---
DISCOVERY_PROVIDER=google_places
GOOGLE_PLACES_API_KEY=

# --- Storage ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

# --- Lighthouse / Playwright ---
LIGHTHOUSE_CLI_PATH=lighthouse
PLAYWRIGHT_HEADLESS=true

RATE_LIMIT_PER_MINUTE=60
